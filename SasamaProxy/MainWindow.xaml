<Window x:Class="SasamaProxy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SASAMA Proxy" Height="720" Width="480"
        MinHeight="600" MinWidth="420"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: header -->
            <RowDefinition Height="Auto"/>   <!-- 1: proxy info card -->
            <RowDefinition Height="2*"/>     <!-- 2: program list -->
            <RowDefinition Height="1*"/>     <!-- 3: log -->
            <RowDefinition Height="Auto"/>   <!-- 4: start/stop button -->
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="SASAMA Proxy" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse x:Name="EngineStatusDot" Width="8" Height="8" Fill="{StaticResource OfflineRedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="EngineStatusText" Text="Disconnected" Margin="6,0,0,0" Foreground="{StaticResource OfflineRedBrush}" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="EmergencyStopButton" Style="{StaticResource IconButtonStyle}" ToolTip="Emergency Stop - instantly force-stops all redirection" Click="EmergencyStopButton_Click" Margin="0,0,8,0">
                    <TextBlock Text="&#9888;" FontSize="16" Foreground="{StaticResource AccentRedBrush}"/>
                </Button>
                <Button x:Name="DonationButton" Style="{StaticResource IconButtonStyle}" ToolTip="Donation / حمایت مالی" Click="DonationButton_Click" Margin="0,0,8,0">
                    <TextBlock Text="&#10084;" FontSize="15" Foreground="{StaticResource AccentRedBrush}"/>
                </Button>
                <Button x:Name="SettingsButton" Style="{StaticResource IconButtonStyle}" ToolTip="Settings" Click="SettingsButton_Click">
                    <TextBlock Text="&#9881;" FontSize="17"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== Proxy info card ===================== -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse x:Name="ProxyStatusDot" Width="9" Height="9" Fill="{StaticResource OfflineRedBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ProxyStatusText" Text="offline" Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>

                    <TextBox Grid.Column="1" x:Name="ProxyNameTextBox" Text="V2RAY" Style="{StaticResource RoundedTextBoxStyle}" Margin="0,0,6,0" ToolTip="Name (label only)"/>
                    <TextBox Grid.Column="2" x:Name="ProxyIpTextBox" Text="127.0.0.1" Style="{StaticResource RoundedTextBoxStyle}" Margin="0,0,6,0" ToolTip="Local proxy IP"/>
                    <TextBox Grid.Column="3" x:Name="ProxyPortTextBox" Text="10808" Width="60" Style="{StaticResource RoundedTextBoxStyle}" ToolTip="Local proxy port"/>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="LatencyText" Text="Latency: --" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="13"/>
                    <Button Grid.Column="1" x:Name="PingButton" Content="Ping" Style="{StaticResource SmallActionButtonStyle}" Click="PingButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================== Program list ===================== -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Program" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="AddProgramButton" Content="+ Add" Style="{StaticResource SmallActionButtonStyle}" Click="AddProgramButton_Click"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ProgramListItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Checked="RuleCheckBox_Changed" Unchecked="RuleCheckBox_Changed" Tag="{Binding}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ProcessName}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                    <Button Grid.Column="2" Content="&#10005;" Style="{StaticResource IconButtonStyle}" Width="26" Height="26" FontSize="11" Tag="{Binding}" Click="RemoveRuleButton_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== Log ===================== -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <ListBox x:Name="LogListBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>

        <!-- ===================== Start / Stop ===================== -->
        <Button Grid.Row="4" x:Name="StartStopButton" Content="START PROXY" Height="52" Style="{StaticResource PrimaryButtonStyle}" Click="StartStopButton_Click"/>
    </Grid>
</Window>
