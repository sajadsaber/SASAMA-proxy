<Window x:Class="SasamaProxy.AddProcessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Program" Height="480" Width="380"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add Program" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Text="Type the .exe name (works even if it's not running yet):" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBox Grid.Row="2" x:Name="ManualNameTextBox" Style="{StaticResource RoundedTextBoxStyle}" Margin="0,0,0,12"/>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Or pick a running program:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                <ListBox x:Name="RunningProcessesListBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" SelectionChanged="RunningProcessesListBox_SelectionChanged"/>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{StaticResource SmallActionButtonStyle}" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button Content="Add" Style="{StaticResource PrimaryButtonStyle}" Width="90" Height="34" Click="AddButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
